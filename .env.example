# -----------------------------------------------------------------------------
# Ovalens — root env example (CI/deploy scripts, Vercel deploy)
# Copy to .env and set real values. Never commit .env.
# App-specific vars: OvalensPlanner/apps/api/.env and OvalensPlanner/apps/web/.env
# -----------------------------------------------------------------------------

# ---------- Vercel deployment (required for review-test-deploy / CI deploy) ----------
# Create at: GitHub → Repo → Settings → Secrets and variables → Actions → Secrets
# Or use .env locally only; never commit .env.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID_API=
VERCEL_PROJECT_ID_WEB=

# Optional: used by some CI or deploy scripts to pass Supabase/Vercel project config.
# Prefer GitHub Secrets or Vercel env for production.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
