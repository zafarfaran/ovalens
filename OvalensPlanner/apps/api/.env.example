# -----------------------------------------------------------------------------
# Ovalens API — example environment variables
# Copy to .env and set real values. Never commit .env.
# -----------------------------------------------------------------------------

# Database (required for Supabase/Postgres in beta and production)
# For local dev with SQLite, omit or leave default.
# For Supabase: use Connection string from Project Settings → Database (URI).
# Use direct URL; the app will use the async driver (postgresql+asyncpg).
# Example (replace password and ref): postgresql://postgres.[ref]:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@host:5432/dbname

# AI (Anthropic required for chat)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=claude-sonnet-4-20250514

# App
ENVIRONMENT=development
LOG_LEVEL=DEBUG
# Default tax year for calculations (e.g. 2025/26). If unset, derived from current date.
# DEFAULT_TAX_YEAR=2025/26
# JSON list of allowed CORS origins (optional; defaults include localhost and www.ovalens.com)
# CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","https://www.ovalens.com","https://ovalens.com"]

# Auth: Supabase JWT secret (Project Settings → API → JWT Secret) for validating access tokens
SUPABASE_JWT_SECRET=
