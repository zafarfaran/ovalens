# -----------------------------------------------------------------------------
# Ovalens API — example environment variables
# Copy to .env and set real values. Never commit .env.
# -----------------------------------------------------------------------------
#
# Environments:
#   development — local dev; use SQLite or a local Postgres (never production URL).
#   test        — used by pytest; DB is test_database_url (in-memory SQLite by default).
#   beta / production — DATABASE_URL and SUPABASE_JWT_SECRET required (Supabase).
# -----------------------------------------------------------------------------

# App (local dev: use development and default SQLite so you never touch production)
ENVIRONMENT=development

# Database
# Local dev: omit or use default below (SQLite). Do not point at production.
# Beta/Prod (and Vercel): set DATABASE_URL to Supabase Postgres URI (Project Settings → Database → Connection string).
# Example: postgresql://postgres.[ref]:YOUR_PASSWORD@...supabase.com:5432/postgres
# Local dev default (do not use in production):
DATABASE_URL=sqlite+aiosqlite:///./helio.db
# Tests: only used when ENVIRONMENT=test (pytest). Default in-memory SQLite.
# TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# AI (Anthropic required for chat)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=claude-sonnet-4-20250514

# Logging
LOG_LEVEL=DEBUG
# Default tax year for calculations (e.g. 2025/26). If unset, derived from current date.
# DEFAULT_TAX_YEAR=2025/26
# JSON list of allowed CORS origins (optional; defaults include localhost and www.ovalens.com)
# CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","https://www.ovalens.com","https://ovalens.com"]

# Auth (required for beta/prod): Supabase JWT secret (Project Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=

# Sentry (optional). DSN from Sentry project settings. Unset = error monitoring disabled.
# SENTRY_DSN=
# SENTRY_RELEASE=ovalens-api@0.0.1

# Rate limiting (expensive endpoints). 0 = disabled.
# RATE_LIMIT_CHAT_STREAM_PER_USER=30
# RATE_LIMIT_CHAT_STREAM_PER_IP=60
# RATE_LIMIT_CONTEXT_INGEST_PER_USER=20
# RATE_LIMIT_CONTEXT_INGEST_PER_IP=40
# RATE_LIMIT_WINDOW_SECONDS=60
# Set True only when behind a trusted proxy that sets X-Forwarded-For (e.g. Vercel).
# RATE_LIMIT_TRUST_PROXY=false

# Input size: max characters per user message in chat (limits LLM input cost). 0 = no limit.
# CHAT_MAX_MESSAGE_LENGTH=32000
