# -----------------------------------------------------------------------------
# Ovalens Web (Next.js) — example environment variables
# Copy to .env and set real values. Never commit .env.
# -----------------------------------------------------------------------------
#
# Beta/Production: set NEXT_PUBLIC_APP_URL, NEXT_PUBLIC_API_URL, BACKEND_URL,
# NEXT_PUBLIC_SUPABASE_URL, and NEXT_PUBLIC_SUPABASE_ANON_KEY for your deployed URLs.
# -----------------------------------------------------------------------------

# App URL (used for auth callbacks; beta/prod: set to https://www.ovalens.com or your domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API base URL (browser and server; local dev default)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend URL for server-side proxy (chat stream, etc.). Usually same as NEXT_PUBLIC_API_URL.
BACKEND_URL=http://localhost:8000

# Supabase (required for Auth). Project Settings → API:
# - Project URL → NEXT_PUBLIC_SUPABASE_URL
# - anon/public key → NEXT_PUBLIC_SUPABASE_ANON_KEY (sometimes labeled "Publishable key")
# These are public; do not put service_role or JWT secret here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry (optional). DSN from Sentry project settings. Client (browser) needs NEXT_PUBLIC_ prefix.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_RELEASE=ovalens-web@0.0.1
# Source map upload (CI): SENTRY_ORG=, SENTRY_PROJECT=, SENTRY_AUTH_TOKEN=
