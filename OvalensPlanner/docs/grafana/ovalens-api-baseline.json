          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum(rate(ovalens_chat_time_to_first_token_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p50",
          "refId": "B"
