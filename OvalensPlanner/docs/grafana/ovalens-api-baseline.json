      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum(rate(ovalens_http_request_duration_seconds_bucket[$__rate_interval])) by (le, method))",
          "legendFormat": "p99 {{method}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum(rate(ovalens_http_request_duration_seconds_bucket[$__rate_interval])) by (le, method))",
          "legendFormat": "p50 {{method}}",
          "refId": "B"
        }
      ],
      "title": "HTTP latency (p50, p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
