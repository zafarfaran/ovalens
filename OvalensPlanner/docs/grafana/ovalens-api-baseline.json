        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "increase(ovalens_chat_stream_completions_total[$__range])", "legendFormat": "Completions", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "increase(ovalens_chat_stream_errors_total[$__range])", "legendFormat": "Errors", "refId": "C" }
